# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env
.env*.local

# Common ignores
node_modules
# The repo's lockfile is pnpm-lock.yaml. The Dockerfile installs with
# `npm install --legacy-peer-deps`, so a package-lock.json created by a local
# npm install would silently become the production build's resolution source.
# Keep it out of the repo.
package-lock.json
.next/
*.tsbuildinfo
.DS_Store
# Convex codegen output (regenerated by npx convex dev)
convex/_generated/

# Playwright / E2E artifacts
/test-results/
/playwright-report/
/blob-report/
e2e/.auth/
e2e/.e2e-db.sqlite3
